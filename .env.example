# Copy to .env (never commit .env). All settings are optional.

# Telegram alerts: token from @BotFather. Without it the app runs without the bot.
TELEGRAM_BOT_TOKEN=

# Live data: "off" disables it. Solana RPC used only for the epoch check (default: public mainnet RPC).
# LIVE=off
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# PORT=3001
